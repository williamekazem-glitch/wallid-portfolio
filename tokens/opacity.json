{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Échelle d'opacité — utilisée pour overlays, hover, disabled, sur-couches.",
  "opacity": {
    "0":   { "$value": "0",    "$type": "number" },
    "5":   { "$value": "0.05", "$type": "number" },
    "10":  { "$value": "0.10", "$type": "number", "$description": "Bg subtils (badge success sur bg-elev)" },
    "20":  { "$value": "0.20", "$type": "number", "$description": "Bg sur ping animation" },
    "30":  { "$value": "0.30", "$type": "number", "$description": "Bordure de badge success" },
    "40":  { "$value": "0.40", "$type": "number" },
    "50":  { "$value": "0.50", "$type": "number", "$description": "Overlay sombre modéré, hero blur halo" },
    "60":  { "$value": "0.60", "$type": "number" },
    "70":  { "$value": "0.70", "$type": "number", "$description": "Text muted alt" },
    "75":  { "$value": "0.75", "$type": "number", "$description": "Ping animation opacity" },
    "80":  { "$value": "0.80", "$type": "number", "$description": "Backdrop de nav sticky" },
    "90":  { "$value": "0.90", "$type": "number", "$description": "Hover sur bouton primaire" },
    "100": { "$value": "1",    "$type": "number" }
  }
}
