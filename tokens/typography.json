{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Échelle typographique — ratio Major Third (1.25) sur base 16px.",
  "font": {
    "family": {
      "display": { "$value": "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily", "$description": "Titres bold sans, tracking serré" },
      "sans":    { "$value": "Inter, ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily", "$description": "Body / interfaces" },
      "serif":   { "$value": "'Instrument Serif', 'Times New Roman', Georgia, serif", "$type": "fontFamily", "$description": "Italiques éditoriales, taglines, accents" },
      "mono":    { "$value": "ui-monospace, 'SFMono-Regular', Menlo, monospace", "$type": "fontFamily" }
    },
    "size": {
      "$description": "Major Third scale (ratio 1.25) — base 16px = 1rem",
      "xs":    { "$value": "0.75rem",  "$type": "dimension", "$description": "12px — labels, meta" },
      "sm":    { "$value": "0.875rem", "$type": "dimension", "$description": "14px — small body, nav" },
      "base":  { "$value": "1rem",     "$type": "dimension", "$description": "16px — body" },
      "lg":    { "$value": "1.125rem", "$type": "dimension", "$description": "18px — large body" },
      "xl":    { "$value": "1.25rem",  "$type": "dimension", "$description": "20px" },
      "2xl":   { "$value": "1.5rem",   "$type": "dimension", "$description": "24px" },
      "3xl":   { "$value": "1.875rem", "$type": "dimension", "$description": "30px" },
      "4xl":   { "$value": "2.25rem",  "$type": "dimension", "$description": "36px" },
      "5xl":   { "$value": "3rem",     "$type": "dimension", "$description": "48px — display md" },
      "6xl":   { "$value": "3.75rem",  "$type": "dimension", "$description": "60px — display lg" },
      "7xl":   { "$value": "4.5rem",   "$type": "dimension", "$description": "72px — display xl" },
      "8xl":   { "$value": "6rem",     "$type": "dimension", "$description": "96px — display 2xl" }
    },
    "tracking": {
      "$description": "Letter-spacing tiers.",
      "tight":   { "$value": "-0.02em",  "$type": "dimension" },
      "tighter": { "$value": "-0.03em",  "$type": "dimension" },
      "display": { "$value": "-0.035em", "$type": "dimension", "$description": "Display sizes (Newsreader/Instrument Serif)" },
      "normal":  { "$value": "0",        "$type": "dimension" },
      "wide":    { "$value": "0.06em",   "$type": "dimension" },
      "eyebrow": { "$value": "0.14em",   "$type": "dimension", "$description": "Section eyebrows (uppercase)" },
      "meta":    { "$value": "0.18em",   "$type": "dimension", "$description": "Meta labels" }
    },
    "leading": {
      "$description": "Line-height tiers.",
      "none":    { "$value": "1",    "$type": "number" },
      "tight":   { "$value": "1.1",  "$type": "number" },
      "snug":    { "$value": "1.25", "$type": "number" },
      "normal":  { "$value": "1.5",  "$type": "number" },
      "relaxed": { "$value": "1.6",  "$type": "number" },
      "loose":   { "$value": "1.8",  "$type": "number" }
    },
    "weight": {
      "regular":  { "$value": "400", "$type": "fontWeight" },
      "medium":   { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold":     { "$value": "700", "$type": "fontWeight", "$description": "Space Grotesk display" }
    }
  }
}
